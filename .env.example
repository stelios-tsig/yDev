# Κλειδί υπογραφής JWT — βάλε μια τυχαία, μυστική συμβολοσειρά.
SECRET_KEY=change-me

# Σύνδεση βάσης δεδομένων. Αν λείπει, γίνεται fallback σε τοπικό SQLite
# (sqlite:///./ydev.db). Σε production βάλε το connection string της
# PostgreSQL (π.χ. Neon): postgresql://user:password@host/dbname
DATABASE_URL=

# Στοιχεία Cloudinary για το ανέβασμα εικόνων.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP για τα emails επαναφοράς κωδικού. Αν το SMTP_HOST είναι κενό, ο σύνδεσμος
# επαναφοράς απλώς τυπώνεται στο console (dev mode) αντί να σταλεί email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
