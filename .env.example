# Κλειδί υπογραφής JWT — βάλε μια τυχαία, μυστική συμβολοσειρά.
SECRET_KEY=change-me

# Σύνδεση βάσης δεδομένων. Αν λείπει, γίνεται fallback σε τοπικό SQLite
# (sqlite:///./ydev.db). Σε production βάλε το connection string της
# PostgreSQL (π.χ. Neon): postgresql://user:password@host/dbname
DATABASE_URL=

# Στοιχεία Cloudinary για το ανέβασμα εικόνων.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Emails επαναφοράς κωδικού ---
# Προτεραιότητα: Resend > SMTP > console. Αν κανένα δεν είναι ρυθμισμένο, ο
# σύνδεσμος επαναφοράς τυπώνεται στο console (dev mode).

# Resend HTTP API — δουλεύει και σε hosts που μπλοκάρουν SMTP (π.χ. Render).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# SMTP (π.χ. Gmail) — βολικό για τοπική χρήση.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
